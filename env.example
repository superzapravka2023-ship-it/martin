# --- Bybit (демо-аккаунт) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
DEMO=true

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Капитал ---
BASE_NOTIONAL=200
LEVERAGE=20
MAX_POSITIONS=3
TAKE_PROFIT_PCT=0.6
EQUITY_FLOOR=600

# --- Вселенная ---
MIN_TURNOVER_24H=10000000
MIN_LISTING_DAYS=30
MAX_SCAN_SYMBOLS=120
BLACKLIST=

# --- Сигналы ---
# RSI7 30/70 — база (~228 сигналов/день на 120 монет, слотов всего 3).
# Хочешь ещё чаще: RSI_OVERSOLD=35 / RSI_OVERBOUGHT=65.
# Хочешь реже и отборнее: RSI_OVERSOLD=25 / RSI_OVERBOUGHT=75.
# RSI_PERIOD=14 с порогами 30/70 НЕ РАБОТАЕТ — сигналов не будет совсем.
RSI_PERIOD=7
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MIN_ATR_PCT=0.4
MAX_HOUR_MOVE_PCT=8
BTC_CRASH_PCT=-3
COOLDOWN_MINUTES=60

# --- Прочее ---
DAILY_REPORT_HOUR=9
TZ_OFFSET_HOURS=3
DB_PATH=/data/bot.db
